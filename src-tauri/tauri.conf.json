{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PureGate",
  "version": "0.3.0",
  "identifier": "com.zhilong.claudegate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PureGate 净启",
        "width": 1180,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "LicenseRef-PureGate",
    "licenseFile": "../LICENSE",
    "publisher": "zhilong9966",
    "copyright": "Copyright (c) 2026 zhilong9966. PureGate 净启 - free for personal use; commercial use requires a license: zhilongfeng66@gmail.com",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "PureGate 净启 - AI 桌面应用安全启动器"
  }
}